# PostgreSQL connection string. Locally this can be a Postgres you run yourself
# or a free hosted one (Neon, Supabase); in production it is your host's.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/floralforu?schema=public"

# Signs the admin session cookie. Must be 32+ random characters, and MUST be a
# different value in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Direct (non-pooled) connection, used by `prisma migrate`. On Neon this is the
# same string without `-pooler` in the hostname. Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/floralforu?schema=public"

# Cloudinary, for uploading product photos from /admin. Optional: leave these
# blank and the admin falls back to pasting image URLs. Values are on the
# Cloudinary dashboard under "API Keys". The secret signs uploads server-side
# and must never be committed or exposed to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
